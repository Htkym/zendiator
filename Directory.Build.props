<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Version>1.0.1</Version>
    <Authors>tkym</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Htkym/zendiator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Htkym/zendiator</PackageProjectUrl>
    <PackageTags>mediator;source-generator;CQRS;AOT</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.0.1 reduces per-cursor storage and first-send allocations in mixed DI compositions. The stream benchmarks show how to pool a custom cursor's asynchronous move helper. See https://github.com/Htkym/zendiator/blob/v1.0.1/docs/release/1.0.1-release-notes.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation Condition="'$(PackageValidationBaselineVersion)' != ''">true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackageValidationBaselinePath)' != ''">
    <NuGetPackInput Include="$(PackageValidationBaselinePath)" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
  </ItemGroup>
  <!-- Keep formal child binaries stable across BDN artifact directories. -->
  <Target Name="_NormalizeZendiatorFormalArtifactPaths"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile"
          DependsOnTargets="_SetPathMapFromSourceRoots"
          Condition="'$(ZendiatorFormalMeasurement)' == 'true' and '$(ArtifactsPath)' != ''">
    <PropertyGroup>
      <_ZendiatorFormalArtifactRoot>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)'))</_ZendiatorFormalArtifactRoot>
      <PathMap Condition="'$(PathMap)' != ''">$(_ZendiatorFormalArtifactRoot)=/_/zendiator-bdn/,$(PathMap)</PathMap>
      <PathMap Condition="'$(PathMap)' == ''">$(_ZendiatorFormalArtifactRoot)=/_/zendiator-bdn/</PathMap>
    </PropertyGroup>
  </Target>
</Project>
