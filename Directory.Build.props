<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Version>0.7.0</Version>
    <Authors>tkym</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Htkym/zendiator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Htkym/zendiator</PackageProjectUrl>
    <PackageTags>mediator;source-generator;CQRS;AOT</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Zendiator 0.7.0 resolves eligible closed SendAsync receivers before the first Before callback and captures Transient receivers per route. Rebuild consumers; see docs/release/0.7.0-release-notes.md for migration.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation Condition="'$(PackageValidationBaselineVersion)' != ''">true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
  </ItemGroup>
  <!-- Keep formal child binaries stable across BDN artifact directories. -->
  <Target Name="_NormalizeZendiatorFormalArtifactPaths"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile"
          DependsOnTargets="_SetPathMapFromSourceRoots"
          Condition="'$(ZendiatorFormalMeasurement)' == 'true' and '$(ArtifactsPath)' != ''">
    <PropertyGroup>
      <_ZendiatorFormalArtifactRoot>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)'))</_ZendiatorFormalArtifactRoot>
      <PathMap Condition="'$(PathMap)' != ''">$(_ZendiatorFormalArtifactRoot)=/_/zendiator-bdn/,$(PathMap)</PathMap>
      <PathMap Condition="'$(PathMap)' == ''">$(_ZendiatorFormalArtifactRoot)=/_/zendiator-bdn/</PathMap>
    </PropertyGroup>
  </Target>
</Project>
