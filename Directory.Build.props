<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Version>0.3.0</Version>
    <Authors>tkym</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Htkym/zendiator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Htkym/zendiator</PackageProjectUrl>
    <PackageTags>mediator;source-generator;CQRS;AOT</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Zendiator 0.3.0: generated handlers and behaviors default to Transient with a Scoped mediator; generated mediators no longer implement IDisposable or guarantee ObjectDisposedException after scope disposal. Lifetime analyzer warnings, composition-specific resolver slots, and a reproducible use-case benchmark are included. AddZendiator() and IZendiator.SendAsync remain the standard entry points. See https://github.com/Htkym/zendiator/blob/v0.3.0/docs/release/0.3.0-release-notes.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation Condition="'$(PackageValidationBaselineVersion)' != ''">true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
  </ItemGroup>
</Project>
