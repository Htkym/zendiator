<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Foundatio.Mediator interceptors rewrite call sites at compile time. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Foundatio.Mediator</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Zendiator\Zendiator.csproj" />
    <ProjectReference Include="..\Zendiator.DSoftObs\Zendiator.DSoftObs.csproj" />
    <ProjectReference Include="..\..\src\Zendiator.SourceGenerator\Zendiator.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Comparison targets (benchmarks only, never shipped). Versions are latest
         stable, except MediatR which is pinned to the last 12.x: 13+ is commercial
         and needs a license key, which would distort the comparison. -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Foundatio.Mediator" Version="1.3.3" />
    <PackageReference Include="DispatchR.Mediator" Version="2.3.1" />
    <PackageReference Include="DSoftStudio.Mediator" Version="1.3.0" />
    <PackageReference Include="Immediate.Handlers" Version="4.0.0" />
  </ItemGroup>
</Project>
