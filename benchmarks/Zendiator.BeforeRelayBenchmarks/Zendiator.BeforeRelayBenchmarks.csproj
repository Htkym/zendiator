<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Zendiator.Generated.Interceptors</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Zendiator/Zendiator.csproj" />
    <ProjectReference Include="../../src/Zendiator.SourceGenerator/Zendiator.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../Zendiator.UseCaseBenchmarks/Work.cs" Link="Shared/Work.cs" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.12]" />
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
  </ItemGroup>
</Project>
