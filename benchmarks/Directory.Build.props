<Project>
  <!-- Layer over the repo root policy (MSBuild imports only the nearest
       Directory.Build.props, so re-import the parent explicitly). -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />
  <PropertyGroup Condition="'$(ZendiatorFormalMeasurement)' == 'true'">
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.15]" />
  </ItemGroup>
</Project>
